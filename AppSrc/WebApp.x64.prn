38416>>>        Boolean bHasRecord
38416>>>        Handle hoDD
38416>>>
38416>>>        Get Server to hoDD
38417>>>        Get GetNavigateData to NavigateData
38418>>>        Get HasRecord of hoDD to bHasRecord
38419>>>
38419>>>        // let's hide all buttons and then Show the ones we want
38419>>>        WebSet pbRender of oEditBtn to False
38420>>>        WebSet pbRender of oSaveBtn to False
38421>>>        WebSet pbRender of oCancelChangesBtn to False
38422>>>        WebSet pbRender of oDeleteBtn to False
38423>>>
38423>>>        If (NavigateData.bReadOnly) Begin
38425>>>            WebSet pbRender of oEditBtn to True
38426>>>        End
38426>>>>
38426>>>        Else Begin
38427>>>            WebSet pbRender of oSaveBtn to True
38428>>>            WebSet pbRender of oCancelChangesBtn to True
38429>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38430>>>        End
38430>>>>
38430>>>    End_Procedure
