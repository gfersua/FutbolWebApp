38964>>>        Get GetNavigateData to NavigateData
38965>>>        Get HasRecord of hoDD to bHasRecord
38966>>>
38966>>>        // let's hide all buttons and then Show the ones we want
38966>>>        WebSet pbRender of oEditBtn to False
38967>>>        WebSet pbRender of oSaveBtn to False
38968>>>        WebSet pbRender of oCancelChangesBtn to False
38969>>>        WebSet pbRender of oDeleteBtn to False
38970>>>
38970>>>        If (NavigateData.bReadOnly) Begin
38972>>>            WebSet pbRender of oEditBtn to True
38973>>>        End
38973>>>>
38973>>>        Else Begin
38974>>>            WebSet pbRender of oSaveBtn to True
38975>>>            WebSet pbRender of oCancelChangesBtn to True
38976>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38977>>>        End
38977>>>>
38977>>>    End_Procedure
