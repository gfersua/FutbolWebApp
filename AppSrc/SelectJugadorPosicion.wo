// C:\DataFlex Projects\FutbolWebApp\AppSrc\SelectJugadorPosicion.wo
// SelectJugadorPosicion
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use ZoomJugadorPosicion.wo

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd

Object oSelectJugadorPosicion is a cWebView
    Set psCaption to "JugadorPosicion"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Object oposicion_DD is a cposicionDataDictionary
    End_Object 
    
    Object oposicionesTotalesDD is a cposicionDataDictionary
    End_Object

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server To ojugador_DD
        Set DDO_Server To oposicion_DD
    End_Object 

    Set Main_DD to ojugadorposicion_DD
    Set Server  to ojugadorposicion_DD
    
          
        Object oposicionesTotales_List is a cWebList
            
            Set piColumnSpan to 4
            
            Set Server to oposicionesTotalesDD
            Set pbVisible to True
            
            Object oposicionNombre is a cWebColumn
                Entry_Item posicion.Nombre
                Set psCaption to "Posiciones totales"
                Set piWidth to 500
           End_Object 
            
        End_Object
        
        
        Object oQuitar_btn is a cWebButton
            Set psCaption to "Eliminar"
            Set piColumnIndex to 5
            
            
            Procedure OnClick
                
                Send Request_Delete of ojugadorposicion_DD
                Send RefreshListFromDD of oposicionActual_List
                
            End_Procedure
            
        End_Object
        
        
          Object oAnadir_btn is a cWebButton
            Set psCaption to "Añadir"
            Set piColumnIndex to 6
             
            
            Procedure OnClick
                
                Integer iPosicion iJugador
                Boolean bFound
                
                Get Field_Current_Value of oposicionesTotalesDD Field posicion.ID to iPosicion
                Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugador
                Send Clear of ojugadorposicion_DD
                Move iPosicion to jugadorposicion.PosicionID
                Move iJugador to jugadorposicion.JugadorID
                Send Request_Find of ojugadorposicion_DD EQ jugadorposicion.File_Number 2
                Move Found to bFound
                
                If (bFound) Begin
                    Send ShowInfoBox "Ya tiene la posición asignada"
                End
                Else Begin
                    Send Clear of oposicion_DD
                    Move iPosicion to posicion.ID
                    Send Request_Find of oposicion_DD EQ posicion.File_Number 1

                    Send Request_Save of ojugadorposicion_DD
               
                End
                
                Send RefreshListFromDD of oposicionActual_List

            End_Procedure

        End_Object
        
       Object oposicionActual_List is a cWebList
             
         Set piColumnIndex to 7
       
        
         Set pbVisible to True
        
         Object oposicionNombre is a cWebColumn
            Entry_Item posicion.Nombre
            Set psCaption to "Posiciones del jugador"
            Set piWidth to 500
        End_Object 
        
        
       End_Object
       
       Object oDragAndDrop is a cWebDragDropHelper
        
        Send RegisterDragSource oposicionesTotales_List C_WebDragListRow
        Send RegisterDragSource oposicionActual_List C_WebDragListRow
        
        Send RegisterDropTarget oposicionesTotales_List C_WebDropListRow
        Send RegisterDropTarget oposicionActual_List C_WebDropListRow
        
        Procedure onDrop Handle hoDragSource Handle hoDropTarget WebDropPosition eDropPosition
            Forward Send OnDrop hoDragSource hoDropTarget eDropPosition
            
            RowID riCurRi
            Integer iPosicionID iJugadorID
            tWebListDragData listDragData
            Boolean bFound
            String sCurRi
            
            If (hoDragSource = hoDropTarget) Begin
                Send ShowInfoBox "No lo has movido a la lista del jugador"
            End
            Else Begin
                Get DragData of hoDragSource to listDragData
                Move (DeserializeRowID(listDragData.data.sRowID)) to riCurRi
                
                If (hoDragSource = oposicionesTotales_List) Begin
                    Send Clear of oposicionesTotalesDD
                    Send FindByRowId of oposicionesTotalesDD posicion.File_Number riCurRi
                    Move Found to bFound
                    
                    Get Field_Current_Value of oposicionesTotalesDD Field posicion.ID to iPosicionID
                    Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID
                    Send Clear of ojugadorposicion_DD
                    Move iPosicionID to jugadorposicion.PosicionID
                    Move iJugadorID to jugadorposicion.JugadorID
                    
                    Send Request_Find of ojugadorposicion_DD EQ jugadorposicion.File_Number 2
                Move Found to bFound
                
                If (bFound) Begin
                    Send ShowInfoBox "Ya tiene la posición asignada"
                End
                Else Begin
                    Send Clear of oposicion_DD
                    Move iPosicionID to posicion.ID
                    Send Request_Find of oposicion_DD EQ posicion.File_Number 1

                    Send Request_Save of ojugadorposicion_DD
               
                End
                
                Send RefreshListFromDD of oposicionActual_List
                    
                End
                
                
            End
 
            
        End_Procedure
        
       End_Object
       



    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

            WebRegisterPath ntNavigateForward oZoomJugadorPosicion

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        
        
        WebSet pbRender of oNewButton to True
     

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent lookup from a Zoom
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a probably a main-file lookup from a Zoom
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // This may be the start of a drilldown query or this may be used for some kind of custom query.

        Case End
        
         Send RefreshListFromDD of oposicionesTotales_List

    End_Procedure



End_Object 
